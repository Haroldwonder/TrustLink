{
  "name": "@trustlink/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the TrustLink on-chain attestation contract on Stellar",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:fuzz": "node --experimental-vm-modules node_modules/.bin/jest __tests__/errorDecode.fuzz.test.ts",
    "validate": "node scripts/validate-package.js",
    "prepublishOnly": "npm run clean && npm run build && npm run validate",
    "docs": "typedoc --out docs/api src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "stellar",
    "soroban",
    "attestation",
    "kyc",
    "trustlink",
    "blockchain",
    "identity",
    "verification"
  ],
  "author": "TrustLink Team",
  "license": "MIT",
  "homepage": "https://github.com/Haroldwonder/TrustLink#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Haroldwonder/TrustLink.git",
    "directory": "sdk/typescript"
  },
  "bugs": {
    "url": "https://github.com/Haroldwonder/TrustLink/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.14.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typedoc": "^0.26.0",
    "typescript": "^5.4.5"
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": ">=12.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "globals": {
      "ts-jest": {
        "tsconfig": {
          "module": "commonjs",
          "esModuleInterop": true
        }
      }
    }
  }
}
