# EditorConfig helps maintain consistent coding styles across different editors
# and IDEs. See https://editorconfig.org for documentation.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Rust and Python use 4 spaces
[*.{rs,py}]
indent_style = space
indent_size = 4

# TypeScript, JavaScript, JSON, YAML, and Terraform use 2 spaces
[*.{ts,tsx,js,jsx,json,yml,yaml,tf}]
indent_style = space
indent_size = 2

# Makefiles require hard tabs
[Makefile]
indent_style = tab
